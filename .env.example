# Copy to .env and fill in. .env is gitignored; never commit real keys.

DATABASE_URL="postgresql://societyops:societyops_dev@localhost:5432/societyops?schema=public"

# Required in production. The app refuses to boot with the dev fallback when NODE_ENV=production.
JWT_SECRET=""

# Optional. Without it, chat falls back to the deterministic keyword engine.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Optional. All three are needed for real delivery; otherwise notifications are
# recorded with status "Simulated" rather than claiming to have been sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional. Runs the follow-up agent unattended every N minutes.
FOLLOWUP_INTERVAL_MINUTES=""
