# Copy to .env and fill in. .env is gitignored; never commit real keys.

DATABASE_URL="postgresql://societyops:societyops_dev@localhost:5432/societyops?schema=public"

# Required in production. The app refuses to boot with the dev fallback when NODE_ENV=production.
JWT_SECRET=""

# Optional. Without it, chat falls back to the deterministic keyword engine.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Optional. All three are needed for real delivery; otherwise notifications are
# recorded with status "Simulated" rather than claiming to have been sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Minutes between unattended follow-up agent cycles (job queue). Default 5; 0 turns it off.
FOLLOWUP_INTERVAL_MINUTES=""

# --- Photo storage (services/storage) ---
# Set S3_BUCKET to use any S3-compatible store (AWS S3, Cloudflare R2,
# DigitalOcean Spaces, MinIO). Without it photos go to UPLOAD_DIR on local
# disk, which is fine for development but not durable in a container.
# The bucket needs CORS allowing PUT and GET from your app's origin.
S3_BUCKET=""
S3_REGION=""
# Only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "true" for MinIO and other hosts that need path-style URLs.
S3_FORCE_PATH_STYLE=""
# Overrides the origin added to the Content-Security-Policy, e.g. behind a CDN.
S3_PUBLIC_ORIGIN=""
UPLOAD_DIR="uploads"

# --- Error tracking (optional) ---
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
# Browser errors. Read when the frontend is built, not at runtime.
VITE_SENTRY_DSN=""
