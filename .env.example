# Copy to .env and fill in. .env is gitignored; never commit real keys.

DATABASE_URL="postgresql://societyops:societyops_dev@localhost:5432/societyops?schema=public"

# Required in production. The app refuses to boot with the dev fallback when NODE_ENV=production.
JWT_SECRET=""

# Optional. Without it, chat falls back to the deterministic keyword engine.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
